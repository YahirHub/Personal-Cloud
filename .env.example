# HTTP / HTTPS
APP_ADDR=:8080
APP_COOKIE_SECURE=false
APP_REQUIRE_HTTPS=false
APP_WEBDAV_REQUIRE_HTTPS=true
APP_TLS_CERT_FILE=
APP_TLS_KEY_FILE=

# Datos y unidades
APP_DATA_DIR=./data
APP_MOUNT_ROOT=/mnt/personalcloud
APP_MAX_UPLOAD_BYTES=21474836480

# Proxy y sesiones
APP_TRUSTED_PROXIES=127.0.0.1/32,::1/128
APP_SESSION_TTL=168h
